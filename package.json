  },
  "dependencies": {
    "ajv": "^8.20.0",
    "async-mqtt": "^2.6.3",
    "better-ajv-errors": "^2.0.3",
    "bigint-buffer": "^1.1.5",
    "js-yaml": "^5.2.3",
    "luxon": "^3.7.2",
    "net-snmp": "^3.26.3",
    "slugify": "^1.6.9"
